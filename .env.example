# SQLite (local). For Vercel consider Turso (libSQL) or Postgres — see README.
DATABASE_URL=file:./payload.db
# Optional Turso auth when using remote libSQL:
# DATABASE_AUTH_TOKEN=

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (used by Payload / Next)
NEXT_PUBLIC_SERVER_URL=http://localhost:3456

# Optional: seed creates first admin if set (otherwise create via /admin first login)
# PAYLOAD_ADMIN_EMAIL=admin@example.com
# PAYLOAD_ADMIN_PASSWORD=
