# MongoDB — local Docker (see docker-compose.yml; host port 27018 → container 27017)
DATABASE_URL=mongodb://127.0.0.1:27018/lupriv-website
# If host 27017 is free you can map 27017:27017 in compose and use:
# DATABASE_URL=mongodb://127.0.0.1:27017/lupriv-website

# MongoDB — production Atlas (placeholder; set real values in Vercel / .env.local, never commit secrets)
# DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/lupriv-website?retryWrites=true&w=majority

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (used by Payload / Next)
NEXT_PUBLIC_SERVER_URL=http://localhost:3456

# Optional: seed creates first admin if set (otherwise create via /admin first login)
# PAYLOAD_ADMIN_EMAIL=admin@example.com
# PAYLOAD_ADMIN_PASSWORD=

# Optional label only (logged by seed; does not change content)
# SEED_MODE=local
# SEED_MODE=production

# Seed uses the same DATABASE_URL you point at (local Docker or Atlas).
# Untracked .atlas-credentials.env may hold Atlas username/password/URI for reference —
# prefer copying a composed DATABASE_URL into .env.local or Vercel env vars.
